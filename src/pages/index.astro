---
import Layout from "../layouts/Layout.astro";
import Hero from "../sections/Hero.astro";
import Experience from "../sections/Experience.astro";
import Projects from "../sections/Projects.astro";
import MyStackScroll from "../sections/MyStackScroll.astro";
import AboutMe from "../sections/AboutMe.astro";
import Footer from "../sections/Footer.astro";
---

<Layout
  title="Portfolio of Armando Cortés Murillo - Web Developer and Programmer with 15 years of experience"
  description=`Hire a junior Software Developer from Costa Rica with experience in creating innovative technology solutions. Specialized in optimizing business operations through custom applications. Passionate about continuous learning and adapting to new challenges in software development. 👨‍💻`
>
  <main class="w-full flex flex-col px-5 sm:px-10 max-w-[800px] md:px-0">
    <Hero />
    <Experience />
    <MyStackScroll />
    <Projects />
    <AboutMe />
    <Footer />
  </main>
</Layout>
